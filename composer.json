{
    "name": "ssh521/laravel-admin",
    "description": "Reusable Laravel admin panel extracted from admin-yaver.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ssh521\\LaravelAdmin\\": "src/",
            "Ssh521\\LaravelAdmin\\Database\\Seeders\\": "database/seeders/",
            "Ssh521\\LaravelAdmin\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ssh521\\LaravelAdmin\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/view": "^12.0",
        "laravel/jetstream": "^5.0",
        "livewire/livewire": "^3.0",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "laravel/framework": "^12.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ssh521\\LaravelAdmin\\LaravelAdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
