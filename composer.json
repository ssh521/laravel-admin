{
    "name": "ssh521/laravel-admin",
    "description": "Laravel 13 admin foundation with dedicated authentication, roles, permissions, menus, and extensibility.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ssh521\\LaravelAdmin\\": "src/",
            "Ssh521\\LaravelAdmin\\Database\\Seeders\\": "database/seeders/",
            "Ssh521\\LaravelAdmin\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ssh521\\LaravelAdmin\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/view": "^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "spatie/laravel-permission": "^6.0",
        "ssh521/laravel-admin-ui": "^1.0.5"
    },
    "require-dev": {
        "laravel/framework": "^13.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "ssh521/laravel-broadcast-notification": "관리자 리소스 변경, 권한 변경, 로그인 이벤트를 실시간 관리자 알림으로 표시하려면 설치하세요."
    },
    "scripts": {
        "test": "vendor/bin/phpunit --configuration phpunit.xml.dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ssh521\\LaravelAdmin\\LaravelAdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
