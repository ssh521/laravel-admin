{
    "name": "ssh521/laravel-admin",
    "description": "Reusable Laravel admin panel extracted from admin-yaver.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ssh521\\LaravelAdmin\\": "src/",
            "Ssh521\\LaravelAdmin\\Database\\Seeders\\": "database/seeders/",
            "Ssh521\\LaravelAdmin\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ssh521\\LaravelAdmin\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/view": "^13.0",
        "laravel/jetstream": "^5.0",
        "livewire/livewire": "^3.0|^4.0",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-permission": "^6.0",
        "ssh521/laravel-admin-ui": "^1.0"
    },
    "require-dev": {
        "laravel/framework": "^13.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit --configuration phpunit.xml.dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ssh521\\LaravelAdmin\\LaravelAdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
